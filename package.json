{
  "name": "dsh-battery-indicator",
  "version": "1.2.0",
  "description": "Shows the host computer's battery level and charging state below the composer, on every device",
  "license": "MIT",
  "author": "linbtin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/northstacker/dsh-battery-indicator.git"
  },
  "homepage": "https://github.com/northstacker/dsh-battery-indicator#readme",
  "bugs": {
    "url": "https://github.com/northstacker/dsh-battery-indicator/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "battery",
    "pmset",
    "sysfs",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "parse.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "test/*.mjs"
  ],
  "scripts": {
    "test": "node test/parse.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
